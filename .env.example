# X developer app client id used by python3 x_auth.py
X_CLIENT_ID=
# only needed for confidential X apps
# X_CLIENT_SECRET=
# must exactly match the callback configured in the X app
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# optional app-only token for recent search
X_BEARER_TOKEN=

# written by x_auth.py after you approve access
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_ACCESS_TOKEN_EXPIRES_AT=

# optional plain-language rewrite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
